# 统一换行符，避免 core.autocrlf=true 的 Windows 检出把 Go 源码变成 CRLF
# 导致 gofmt -l 全量报告差异、CI 格式门禁常绿失效（T1）。
*        text=auto eol=lf

*.go     text eol=lf
*.mod    text eol=lf
*.sum    text eol=lf
*.md     text eol=lf
*.json   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.ts     text eol=lf
*.tsx    text eol=lf
*.js     text eol=lf
*.jsx    text eol=lf
*.css    text eol=lf
*.html   text eol=lf

# PowerShell 脚本在 Windows 上保持 CRLF
*.ps1    text eol=crlf

# 二进制资源不做换行符转换
*.png    binary
*.ico    binary
*.icns   binary
*.zip    binary
*.exe    binary
*.db     binary
