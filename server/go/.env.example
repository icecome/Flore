# Flore RSS Reader 后端环境变量

# HTTP 服务端口（默认 3002）
PORT=3002

# 绑定地址（默认 127.0.0.1，仅本机访问）
# 设为 0.0.0.0 可允许局域网访问（注意安全风险）
BIND_ADDR=127.0.0.1

# CORS 允许的源（逗号分隔）
# 设为 * 允许所有源（不推荐生产环境使用）
# 默认允许本地开发端口
CORS_ORIGINS=

# API 认证 Token（可选）
# 设置后，敏感路由（导入/导出/数据库管理）需要 Authorization 头
# 格式：Bearer <FLORE_API_TOKEN>
FLORE_API_TOKEN=

# 数据库路径（可选）
# 留空则自动使用 %LOCALAPPDATA%\Flore\reader.db (Windows) 或 ~/.flore/reader.db (其他平台)
# 便携模式：同级 data/ 目录存在时使用 ./data/reader.db
DATABASE_URL=

# 开发者工具（仅开发环境）
# 设为 1 启用 DevTools，生产环境不应设置
FLORE_DEVTOOLS=
